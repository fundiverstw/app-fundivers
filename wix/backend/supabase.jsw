import wixSecretsBackend from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';

const SUPABASE_URL = 'https://pcauozfljgmelxnguqiz.supabase.co';

async function getKey() {
  return wixSecretsBackend.getSecret('SUPABASE_KEY');
}

function headers(key) {
  return {
    apikey: key,
    Authorization: `Bearer ${key}`,
    'Content-Type': 'application/json',
  };
}

async function fetchTable(key, table, params = '') {
  const url = `${SUPABASE_URL}/rest/v1/${table}${params ? '?' + params : ''}`;
  const res = await fetch(url, { method: 'GET', headers: headers(key) });
  const data = await res.json();
  return Array.isArray(data) ? data : [];
}

async function fetchPriceMap(key) {
  const prices = await fetchTable(key, 'EO_prices');
  const map = {};
  prices.forEach(p => { map[p._id || p.id] = p; });
  return map;
}

function resolveStartingAt(item, priceMap) {
  if (item.starting_at != null) return item.starting_at;
  let price = item.price;
  if (typeof price === 'string') {
    try {
      price = JSON.parse(price);
    } catch (_) {
      // Not JSON — leave the raw string so the lookup-by-id branch below picks it up.
    }
  }
  const ref = Array.isArray(price) ? price[0] : price;
  if (!ref) return null;
  if (typeof ref === 'object') return ref.starting_at ?? null;
  const priceId = typeof ref === 'string' ? ref : (ref._id || ref.id);
  if (!priceId) return null;
  return priceMap[priceId]?.starting_at ?? null;
}

// EO_courses runs on an explicit list of days (course_days, a date[], max 4)
// — this replaced the old start_date/end_date envelope. PostgREST serializes
// the array as JS 'YYYY-MM-DD' strings; tolerate a Postgres array literal
// ('{2026-05-09,2026-05-10}') just in case. Returns sorted unique day keys.
function courseDayKeys(item) {
  let raw = item.course_days;
  if (typeof raw === 'string') raw = raw.replace(/^\{|\}$/g, '').split(',');
  const keys = (Array.isArray(raw) ? raw : [])
    .map(s => String(s).slice(0, 10))
    .filter(Boolean);
  return Array.from(new Set(keys)).sort();
}

export async function queryTable(table, filters = {}) {
  const key = await getKey();
  const params = new URLSearchParams(filters).toString();
  return fetchTable(key, table, params);
}

export async function getUpcomingDives(limit = 4) {
  const key = await getKey();
  const todayStr = new Date().toISOString().split('T')[0];
  const params = `start_date=gte.${todayStr}&order=start_date.asc&limit=${limit}`;
  const [dives, priceMap] = await Promise.all([
    fetchTable(key, 'EO_dives', params),
    fetchPriceMap(key),
  ]);
  return dives.map((item, i) => ({
    ...item,
    _id: String(item._id || item.id || i),
    starting_at: resolveStartingAt(item, priceMap),
  }));
}

export async function getUpcomingCourses(limit = 4) {
  const key = await getKey();
  const todayStr = new Date().toISOString().split('T')[0];
  // EO_courses has no start_date column to filter/order on — a course runs on
  // course_days (a date[]). PostgREST can't gte/order by an array's min, so
  // fetch the catalog and pick the upcoming ones (earliest day today-or-later)
  // sorted by that day, client-side. The table is small (marketing catalog).
  const [courses, priceMap] = await Promise.all([
    fetchTable(key, 'EO_courses'),
    fetchPriceMap(key),
  ]);
  return courses
    .map((item, i) => ({
      ...item,
      _id: String(item._id || item.id || i),
      starting_at: resolveStartingAt(item, priceMap),
      _firstDay: courseDayKeys(item)[0] || null,
    }))
    .filter(c => c._firstDay && c._firstDay >= todayStr)
    .sort((a, b) => a._firstDay.localeCompare(b._firstDay))
    .slice(0, limit)
    .map(({ _firstDay, ...c }) => c);
}

function slugify(s) {
  return String(s || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

export async function findDiveByTitleSlug(slug) {
  const target = slugify(slug);
  if (!target) return null;
  const key = await getKey();
  const dives = await fetchTable(key, 'EO_dives');
  return dives.find(d =>
    slugify(d.admin_title) === target || slugify(d.display_title) === target
  ) || null;
}

export async function findCourseByTitleSlug(slug) {
  const target = slugify(slug);
  if (!target) return null;
  const key = await getKey();
  const courses = await fetchTable(key, 'EO_courses');
  return courses.find(c =>
    slugify(c.display_title) === target || slugify(c.calendar_title) === target
  ) || null;
}

function wixImageToUrl(raw) {
  if (!raw) return '';
  const s = String(raw);
  if (!s.startsWith('wix:image://')) return s;
  return s
    .replace(/^wix:image:\/\/v1\//, 'https://static.wixstatic.com/media/')
    .split('#')[0]
    .split('/').slice(0, -1)
    .join('/');
}

async function fetchCertMap(key) {
  const rows = await fetchTable(key, 'cert_levels');
  const map = {};
  rows.forEach(r => { if (r.id) map[r.id] = r; });
  return map;
}

async function fetchTravelMap(key) {
  const rows = await fetchTable(key, 'DiveTravel');
  const map = {};
  rows.forEach(r => { const k = r._id || r.id; if (k) map[k] = r; });
  return map;
}

async function fetchCancellationMap(key) {
  const rows = await fetchTable(key, 'cancellation_policies');
  const map = {};
  rows.forEach(r => { const k = r._id || r.id; if (k) map[k] = r; });
  return map;
}

async function fetchRoomMap(key) {
  const rows = await fetchTable(key, 'EO_rooms');
  const map = {};
  rows.forEach(r => { const k = r._id || r.id; if (k) map[k] = r; });
  return map;
}

function resolveRoomOptions(item, roomMap) {
  const raw = item.room_types;
  if (!raw || typeof raw !== 'string') return [];
  return raw.split(',')
    .map(s => s.trim())
    .filter(Boolean)
    .map(id => roomMap[id])
    .filter(Boolean);
}

function resolveRefId(raw) {
  if (raw == null || raw === '') return null;
  let v = raw;
  if (typeof v === 'string') {
    const trimmed = v.trim();
    if (trimmed.startsWith('[') || trimmed.startsWith('{')) {
      try { v = JSON.parse(trimmed); } catch (_) { return trimmed; }
    } else {
      return trimmed;
    }
  }
  if (Array.isArray(v)) v = v[0];
  if (!v) return null;
  if (typeof v === 'string') return v;
  return v._id || v.id || null;
}

function buildPrereqsText(item, certMap) {
  let cert = item.prereq_cert_id ? certMap[item.prereq_cert_id] : null;
  let note = (item.prereqs || '').trim();
  if (!cert && note && certMap[note]) {
    cert = certMap[note];
    note = '';
  }
  const certName = cert ? cert.name : '';
  if (certName && note) return `${certName} · ${note}`;
  return certName || note || '';
}

export async function getDiveById(id) {
  if (!id) return null;
  const key = await getKey();
  const params = `_id=eq.${encodeURIComponent(id)}`;
  const [rows, priceMap, certMap, travelMap, cancellationMap, roomMap] = await Promise.all([
    fetchTable(key, 'EO_dives', params),
    fetchPriceMap(key),
    fetchCertMap(key),
    fetchTravelMap(key),
    fetchCancellationMap(key),
    fetchRoomMap(key),
  ]);
  const dive = rows[0];
  if (!dive) return null;
  const travel = travelMap[resolveRefId(dive.DiveTravel_reference)] || null;
  const cancellation = cancellationMap[resolveRefId(dive.cancel_policy)] || null;
  return {
    ...dive,
    starting_at: resolveStartingAt(dive, priceMap),
    prereqs: buildPrereqsText(dive, certMap),
    featured_image: wixImageToUrl(dive.featured_image),
    included: travel?.included || '',
    not_included: travel?.not_included || '',
    transportation: travel?.transportation || '',
    cancellation_policy: cancellation?.cancelation_policy || '',
    tagline_text: travel?.tagline_text || '',
    description: travel?.description || '',
    itinerary: travel?.itinerary || '',
    details: travel?.details || '',
    picture: wixImageToUrl(travel?.picture),
    room_options: resolveRoomOptions(dive, roomMap),
  };
}

export async function getCourseById(id) {
  if (!id) return null;
  const key = await getKey();
  const params = `_id=eq.${encodeURIComponent(id)}`;
  const [rows, priceMap, certMap] = await Promise.all([
    fetchTable(key, 'EO_courses', params),
    fetchPriceMap(key),
    fetchCertMap(key),
  ]);
  const course = rows[0];
  if (!course) return null;
  return {
    ...course,
    starting_at: resolveStartingAt(course, priceMap),
    prereqs: buildPrereqsText(course, certMap),
    featured_image: wixImageToUrl(course.featured_image),
  };
}

export async function getCalendarEvents() {
  const key = await getKey();

  const [courses, dives, priceMap] = await Promise.all([
    fetchTable(key, 'EO_courses'),
    fetchTable(key, 'EO_dives'),
    fetchPriceMap(key),
  ]);

  const dayDiff = (a, b) => Math.round((new Date(b).getTime() - new Date(a).getTime()) / 86400000);

  // Group sorted days into runs of consecutive dates → one calendar
  // segment per run. Adjacent days render as a single continuous bar;
  // gaps render as separate pills. Mirrors courseToEvents in
  // src/lib/events.ts so the Wix calendar matches the PWA.
  const groupRuns = (days) => {
    const runs = [];
    for (const d of days) {
      const last = runs[runs.length - 1];
      if (last && dayDiff(last[1], d) === 1) last[1] = d;
      else runs.push([d, d]);
    }
    return runs;
  };

  const courseEvents = courses.flatMap((item) => {
    const days = courseDayKeys(item);
    if (days.length === 0) return [];
    const base = {
      id: item._id || item.id,
      title: item.calendar_title || '',
      display_title: item.display_title || '',
      type: 'course',
      featured: item.featured || false,
      starting_at: resolveStartingAt(item, priceMap),
      url: (item.url && String(item.url).trim()) || item['link-eo-courses-course_title'] || '',
    };
    return groupRuns(days).map(([start_date, end_date]) => ({ ...base, start_date, end_date }));
  });

  const diveEvents = dives.flatMap((item) => {
    if (!item.start_date) return [];
    const start = new Date(item.start_date);
    const end = item.end_date ? new Date(item.end_date) : start;
    return [{
      id: item._id || item.id,
      start_date: start.toISOString().split('T')[0],
      end_date:   end.toISOString().split('T')[0],
      title:      item.calendar_title || '',
      display_title: item.display_title || '',
      type:       'dive',
      url:        item['link-eo-dives-dive_title'] || '',
      featured:   item.featured || false,
      starting_at: resolveStartingAt(item, priceMap),
    }];
  });

  return [...courseEvents, ...diveEvents];
}
