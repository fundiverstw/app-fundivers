# Two env files, both gitignored. `fundive` reads .env then .env.local from
# this directory (the process environment wins); a production build also reads
# .env.production, whose VITE_* values win over .env.local's.

# ── .env.local ─────────────────────────────────────────────────────────────
# Production Supabase credentials: edge-function deploys, db push/adopt, backups.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=
# Local stack values for `make dev` (from `supabase status` in a fundive clone).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── .env.production ────────────────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_TURNSTILE_SITE_KEY=
# VITE_VAPID_PUBLIC_KEY=
# VITE_PUSH_WORKER_URL=
